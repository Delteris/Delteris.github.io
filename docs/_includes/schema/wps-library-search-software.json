{%- comment %} Localised by the sx_* variables set in _layouts/default.html; the FAQPage is
     generated there from the page's own visible FAQ. {%- endcomment %}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": {% if sx_L == 'en' %}"Elenchon Atlas — WPS Library & Search Software"{% else %}{{ sx_name | jsonify }}{% endif %},
      "applicationCategory": "BusinessApplication",
      "applicationSubCategory": "WPS Management Software",
      "operatingSystem": "Cloud",
      "description": {% if sx_L == 'en' %}"Cloud WPS library software: every WPS, pWPS and WPQR parsed into a structured record you search, filter, compare, correct and link. Filter by process, material, position, side and pass role; revisions grouped automatically; the whole qualification chain linked; edit and verify in place — the library managed entirely in the app."{% else %}{{ sx_desc | jsonify }}{% endif %},
{% if sx_L == 'en' %}      "keywords": "WPS library software, WPS search, filter WPS by process, WPS database, WPQR linking, pWPS management, WPS revisions, welding procedure library",{% endif %}
{% if sx_L == 'en' %}      "featureList": [
        "WPS, pWPS and WPQR as structured, searchable records",
        "Filter by process, base and filler material, position and thickness range",
        "Pass-table facets: side, role, process and polarity as set-membership filters",
        "Document facets: parse state, file type, template, link status, linked WPQR",
        "Revisions of a WPS number grouped automatically with a switcher",
        "Edit values and labels in place, with one-click verify of low-confidence reads",
        "Link the WPS to WPQR to pWPS qualification chain"
      ],{% endif %}
      "offers": {
        "@type": "Offer",
        "price": "80",
        "priceCurrency": "EUR",
        "url": "https://delteris.com{{ sx_px }}/wps-management-software.html#pricing",
        "availability": "https://schema.org/InStock"
      },
      "provider": {
        "@id": "https://delteris.com/#organization"
      },
      "inLanguage": "{{ sx_lang }}"
    }
  ]
}

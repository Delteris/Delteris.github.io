{%- comment %} Localised by the sx_* variables set in _layouts/default.html; the FAQPage is
     generated there from the page's own visible FAQ. {%- endcomment %}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": {% if sx_L == 'en' %}"Elenchon — Welding Equipment & Calibration Management Software"{% else %}{{ sx_name | jsonify }}{% endif %},
      "applicationCategory": "BusinessApplication",
      "applicationSubCategory": "Welding Equipment Management Software",
      "operatingSystem": "Linux/Appliance",
      "description": {% if sx_L == 'en' %}"On-premise welding equipment management software that tracks machine certification and calibration, manages consumable batch inventory and filler-metal traceability, runs a shop-floor maintenance hub, and keeps equipment records audit-ready for ISO 3834, EN 1090 and ASME IX."{% else %}{{ sx_desc | jsonify }}{% endif %},
{% if sx_L == 'en' %}      "keywords": "welding equipment management software, welding machine calibration software, welding equipment calibration tracking, machine certification tracking software, welding consumable inventory software, filler metal traceability software, welding equipment maintenance software, ISO 17662 calibration",{% endif %}
{% if sx_L == 'en' %}      "featureList": [
        "Machine certification and calibration tracking with renewal alerts",
        "Universal equipment register for any machine, not just welding gear",
        "Consumable batch inventory with storage and reheat rules",
        "Filler-metal and heat-number traceability",
        "Five-level shop-floor maintenance hub with role-gated critical tiers",
        "Equipment records audit-ready for ISO 3834, EN 1090 and ASME IX",
        "On-premise appliance with full data sovereignty"
      ],{% endif %}
      "offers": {
        "@type": "Offer",
        "url": "https://delteris.com{{ sx_px }}/pricing.html",
        "availability": "https://schema.org/PreOrder",
        "availabilityStarts": "2027-01-01"
      },
      "provider": {
        "@id": "https://delteris.com/#organization"
      },
      "inLanguage": "{{ sx_lang }}"
    }
  ]
}

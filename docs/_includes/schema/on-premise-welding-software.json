{%- comment %} Localised by the sx_* variables set in _layouts/default.html; the FAQPage is
     generated there from the page's own visible FAQ. {%- endcomment %}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": {% if sx_L == 'en' %}"Elenchon — On-Premise & Offline Welding Software"{% else %}{{ sx_name | jsonify }}{% endif %},
      "applicationCategory": "BusinessApplication",
      "applicationSubCategory": "On-Premise Welding Software",
      "operatingSystem": "Linux/Appliance",
      "description": {% if sx_L == 'en' %}"On-premise, offline-capable welding software delivered as a containerized appliance installed in your facility: full data ownership, no forced cloud updates or outages, offline work capture, automated local backups, and flat published pricing with no per-seat cloud fees."{% else %}{{ sx_desc | jsonify }}{% endif %},
{% if sx_L == 'en' %}      "keywords": "on-premise welding software, offline welding software, self-hosted welding software, welding data sovereignty, sovereign welding software, cloud welding software alternative",{% endif %}
{% if sx_L == 'en' %}      "featureList": [
        "Containerized on-premise appliance installed in your facility",
        "Absolute data ownership with permanent view-only access after cancellation",
        "Offline-capable work capture with automatic sync",
        "Automated local backups to isolated physical storage",
        "Flat published pricing per appliance with hardware passed through at cost",
        "Zero-trust, post-quantum-safe remote access via Phrakton with no open inbound ports"
      ],{% endif %}
      "offers": {
        "@type": "Offer",
        "url": "https://delteris.com{{ sx_px }}/pricing.html",
        "availability": "https://schema.org/PreOrder",
        "availabilityStarts": "2027-01-01"
      },
      "provider": {
        "@id": "https://delteris.com/#organization"
      },
      "inLanguage": "{{ sx_lang }}"
    }
  ]
}

{%- comment %} Localised by the sx_* variables set in _layouts/default.html; the FAQPage is
     generated there from the page's own visible FAQ. {%- endcomment %}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": "{{ sx_url }}#article",
      "headline": {% if sx_L == 'en' %}"Welder Qualification Validity: Continuity, Expiry and Revalidation"{% else %}{{ sx_name | jsonify }}{% endif %},
      "description": {% if sx_L == 'en' %}"How long a welder qualification stays valid: the ISO 9606-1 six-month confirmation, the three revalidation routes, ASME Section IX's six-month expiry rule — and how to keep track across a whole floor."{% else %}{{ sx_desc | jsonify }}{% endif %},
      "inLanguage": "{{ sx_lang }}",
      "mainEntityOfPage": "{{ sx_url }}",
      "datePublished": "2026-07-31",
      "dateModified": "2026-09-23",
      "author": {
        "@type": "Organization",
        "name": "Delteris",
        "url": "https://delteris.com/"
      },
      "publisher": {
        "@id": "https://delteris.com/#organization"
      },
      "image": "https://delteris.com/static/DelterisCrest.webp"
    }
  ]
}

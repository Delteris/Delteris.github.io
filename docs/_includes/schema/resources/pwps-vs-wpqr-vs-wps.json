{%- comment %} Localised by the sx_* variables set in _layouts/default.html; the FAQPage is
     generated there from the page's own visible FAQ. {%- endcomment %}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": "{{ sx_url }}#article",
      "headline": {% if sx_L == 'en' %}"pWPS vs WPQR vs WPS: Meaning and Differences"{% else %}{{ sx_name | jsonify }}{% endif %},
      "description": {% if sx_L == 'en' %}"What pWPS, WPQR and WPS mean: the preliminary procedure you test, the qualification record of that test (ASME calls it a PQR) and the production procedure written inside its range."{% else %}{{ sx_desc | jsonify }}{% endif %},
      "inLanguage": "{{ sx_lang }}",
      "mainEntityOfPage": "{{ sx_url }}",
      "datePublished": "2026-07-31",
      "dateModified": "2026-10-25",
      "author": {
        "@type": "Organization",
        "name": "Delteris",
        "url": "https://delteris.com/"
      },
      "publisher": {
        "@id": "https://delteris.com/#organization"
      },
      "image": "https://delteris.com/static/DelterisCrest.webp"
    }
  ]
}

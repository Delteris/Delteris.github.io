{%- comment %} Localised by the sx_* variables set in _layouts/default.html; the FAQPage is
     generated there from the page's own visible FAQ. {%- endcomment %}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": "{{ sx_url }}#article",
      "headline": {% if sx_L == 'en' %}"pWPS vs WPQR vs WPS: The Difference Explained"{% else %}{{ sx_name | jsonify }}{% endif %},
      "description": {% if sx_L == 'en' %}"A plain-language guide to the three welding procedure records — pWPS (preliminary), WPQR (the qualification record, equivalent to an ASME PQR) and WPS (the production procedure) — and how ISO and ASME differ."{% else %}{{ sx_desc | jsonify }}{% endif %},
      "inLanguage": "{{ sx_lang }}",
      "mainEntityOfPage": "{{ sx_url }}",
      "datePublished": "2026-07-31",
      "dateModified": "2026-09-23",
      "author": {
        "@type": "Organization",
        "name": "Delteris",
        "url": "https://delteris.com/"
      },
      "publisher": {
        "@id": "https://delteris.com/#organization"
      },
      "image": "https://delteris.com/static/DelterisCrest.webp"
    }
  ]
}

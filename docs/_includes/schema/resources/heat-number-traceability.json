{%- comment %} Localised by the sx_* variables set in _layouts/default.html; the FAQPage is
     generated there from the page's own visible FAQ. {%- endcomment %}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": "{{ sx_url }}#article",
      "headline": {% if sx_L == 'en' %}"How Heat-Number Traceability Works"{% else %}{{ sx_name | jsonify }}{% endif %},
      "description": {% if sx_L == 'en' %}"A plain-language guide to heat-number traceability in welding fabrication: MTRs and EN 10204 certificates, heat-number transfer at cutting, and linking material to the finished weld for ISO 3834 and EN 1090."{% else %}{{ sx_desc | jsonify }}{% endif %},
      "inLanguage": "{{ sx_lang }}",
      "mainEntityOfPage": "{{ sx_url }}",
      "datePublished": "2026-07-31",
      "dateModified": "2026-09-23",
      "author": {
        "@type": "Organization",
        "name": "Delteris",
        "url": "https://delteris.com/"
      },
      "publisher": {
        "@id": "https://delteris.com/#organization"
      },
      "image": "https://delteris.com/static/DelterisCrest.webp"
    }
  ]
}

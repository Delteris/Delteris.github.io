{%- comment %} Localised by the sx_* variables set in _layouts/default.html; the FAQPage is
     generated there from the page's own visible FAQ. {%- endcomment %}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": {% if sx_L == 'en' %}"Elenchon — Weld Project Structure & BOM Import Software"{% else %}{{ sx_name | jsonify }}{% endif %},
      "applicationCategory": "BusinessApplication",
      "applicationSubCategory": "Weld Project Structure Software",
      "operatingSystem": "Linux/Appliance",
      "description": {% if sx_L == 'en' %}"On-premise weld project structure software: build any project as an indented tree or an editable flowchart from one source of truth, and paste a BOM straight from Tekla or CAD to build the whole structure in seconds, with automatic column detection."{% else %}{{ sx_desc | jsonify }}{% endif %},
{% if sx_L == 'en' %}      "keywords": "weld project structure software, weld BOM import, Tekla BOM import welding, welding project software, tree flowchart welding, repeatable weld batch software",{% endif %}
{% if sx_L == 'en' %}      "featureList": [
        "Tree and flowchart authoring over one source of truth",
        "One-paste BOM import from Tekla or CAD with automatic column detection",
        "Repeatable batches and bespoke one-offs in one model",
        "Live in-progress project editing with automatic node locking",
        "Heat-number propagation down the project tree",
        "On-premise appliance with full data sovereignty"
      ],{% endif %}
      "offers": {
        "@type": "Offer",
        "url": "https://delteris.com{{ sx_px }}/elenchon-pricing.html",
        "availability": "https://schema.org/PreOrder",
        "availabilityStarts": "2027-01-01"
      },
      "provider": {
        "@id": "https://delteris.com/#organization"
      },
      "inLanguage": "{{ sx_lang }}"
    }
  ]
}

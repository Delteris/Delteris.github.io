{%- comment %} Localised by the sx_* variables set in _layouts/default.html; the FAQPage is
     generated there from the page's own visible FAQ. {%- endcomment %}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "name": {% if sx_L == 'en' %}"Elenchon — On-Premise Welding Management Software"{% else %}{{ sx_name | jsonify }}{% endif %},
      "url": "{{ sx_url }}",
      "description": {% if sx_L == 'en' %}"Elenchon is on-premise welding traceability and management software: shop-floor capture, project structure, the WPS/WPQR/WPQ workflow, equipment and consumables, and audit-ready ISO 3834 and ASME IX evidence on hardware you own. Launching Q1 2027."{% else %}{{ sx_desc | jsonify }}{% endif %},
      "publisher": {
        "@id": "https://delteris.com/#organization"
      },
      "inLanguage": "{{ sx_lang }}"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ sx_home_name | jsonify }}, "item": "{{ sx_home }}" },
        { "@type": "ListItem", "position": 2, "name": "Elenchon", "item": "{{ sx_url }}" }
      ]
    },
    {
      "@type": "ItemList",
      "name": {% if sx_L == 'pt' %}"Pilares de funcionalidades do Elenchon"{% elsif sx_L == 'es' %}"Pilares de funcionalidades de Elenchon"{% else %}"Elenchon capability pillars"{% endif %},
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {% if sx_L == 'pt' %}"Captura de Trabalho sem Atritos"{% elsif sx_L == 'es' %}"Captura de Trabajo sin Fricción"{% else %}"Zero-Friction Work Capture"{% endif %},
          "url": "https://delteris.com{{ sx_px }}/elenchon-platform.html#work-capture"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {% if sx_L == 'pt' %}"Um Projeto, Duas Vistas em Tempo Real"{% elsif sx_L == 'es' %}"Un Proyecto, Dos Vistas en Tiempo Real"{% else %}"One Project, Two Live Views"{% endif %},
          "url": "https://delteris.com{{ sx_px }}/elenchon-platform.html#live-views"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {% if sx_L == 'pt' %}"Gestão & Controlo de Acessos"{% elsif sx_L == 'es' %}"Gestión & Control de Accesos"{% else %}"Management & Access Control"{% endif %},
          "url": "https://delteris.com{{ sx_px }}/elenchon-platform.html#management"
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": {% if sx_L == 'pt' %}"Qualificações & Procedimentos"{% elsif sx_L == 'es' %}"Cualificaciones & Procedimientos"{% else %}"Qualifications & Procedures"{% endif %},
          "url": "https://delteris.com{{ sx_px }}/elenchon-platform.html#qualifications"
        },
        {
          "@type": "ListItem",
          "position": 5,
          "name": {% if sx_L == 'pt' %}"Controlo de Ativos & Consumíveis no Chão de Fábrica"{% elsif sx_L == 'es' %}"Control de Activos & Consumibles en la Planta"{% else %}"Floor Asset & Consumable Control"{% endif %},
          "url": "https://delteris.com{{ sx_px }}/elenchon-platform.html#assets"
        },
        {
          "@type": "ListItem",
          "position": 6,
          "name": {% if sx_L == 'pt' %}"Soberania de Dados à Prova de Bala"{% elsif sx_L == 'es' %}"Soberanía de Datos a Prueba de Balas"{% else %}"Bulletproof Data Sovereignty"{% endif %},
          "url": "https://delteris.com{{ sx_px }}/elenchon-platform.html#sovereignty"
        }
      ]
    }
  ]
}

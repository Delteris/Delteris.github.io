{%- comment %} Roadmap hub (/roadmap.html): a WebPage listing the two product roadmaps.
     Localised by the sx_* variables set in _layouts/default.html. {%- endcomment %}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "name": {{ sx_name | jsonify }},
      "url": "{{ sx_url }}",
      "description": {{ sx_desc | jsonify }},
      "publisher": { "@id": "https://delteris.com/#organization" },
      "inLanguage": "{{ sx_lang }}",
      "hasPart": [
        { "@type": "WebPage", "name": {% if sx_L == 'pt' %}"Roteiro do Elenchon Atlas"{% elsif sx_L == 'es' %}"Hoja de ruta de Elenchon Atlas"{% else %}"Elenchon Atlas Roadmap"{% endif %}, "url": "{{ sx_px | append: '/atlas/roadmap/' | absolute_url }}" },
        { "@type": "WebPage", "name": {% if sx_L == 'pt' %}"Roteiro do Elenchon"{% elsif sx_L == 'es' %}"Hoja de ruta de Elenchon"{% else %}"Elenchon Roadmap"{% endif %}, "url": "{{ sx_px | append: '/elenchon/roadmap/' | absolute_url }}" }
      ]
    }
  ]
}

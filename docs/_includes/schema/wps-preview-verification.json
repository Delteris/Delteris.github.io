{%- comment %} Localised by the sx_* variables set in _layouts/default.html; the FAQPage is
     generated there from the page's own visible FAQ. {%- endcomment %}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": {% if sx_L == 'en' %}"Elenchon Atlas — WPS Preview & Verification"{% else %}{{ sx_name | jsonify }}{% endif %},
      "applicationCategory": "BusinessApplication",
      "applicationSubCategory": "WPS Management Software",
      "operatingSystem": "Cloud",
      "description": {% if sx_L == 'en' %}"Cloud WPS verification: Preview splits the screen with parsed fields on one side and your genuine PDF or Excel document on the other, so every read is confirmed against the original page — and any misread, label or flag is corrected in the same view, syncing everywhere it belongs."{% else %}{{ sx_desc | jsonify }}{% endif %},
{% if sx_L == 'en' %}      "keywords": "WPS verification, WPS preview, verify parsed WPS, WPS against original, WPS proofreading, WPS field verification software",{% endif %}
{% if sx_L == 'en' %}      "featureList": [
        "Split view of parsed fields beside the genuine source document",
        "Real PDF rendered in place, or Excel sheet drawn inline — not a re-render",
        "Draggable divider to widen the source pane up to half the screen",
        "Persistent verification workspace that won't close on a stray click",
        "Correct a value or label and clear low-confidence flags in the same view",
        "Corrections sync to library detail, register column titles and review badge"
      ],{% endif %}
      "offers": {
        "@type": "Offer",
        "price": "80",
        "priceCurrency": "EUR",
        "url": "https://delteris.com{{ sx_px }}/wps-management-software.html#pricing",
        "availability": "https://schema.org/InStock"
      },
      "provider": {
        "@id": "https://delteris.com/#organization"
      },
      "inLanguage": "{{ sx_lang }}"
    }
  ]
}

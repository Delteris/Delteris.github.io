{%- comment %} Localised by the sx_* variables set in _layouts/default.html; the FAQPage is
     generated there from the page's own visible FAQ. {%- endcomment %}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": {% if sx_L == 'en' %}"Elenchon Atlas — Welding Heat Input Calculator"{% else %}{{ sx_name | jsonify }}{% endif %},
      "applicationCategory": "BusinessApplication",
      "applicationSubCategory": "WPS Management Software",
      "operatingSystem": "Cloud",
      "description": {% if sx_L == 'en' %}"A live welding heat input calculator that clamps every control to your WPQR-qualified range. Set the root, fill and cap windows, drag current, voltage and travel-speed sliders, and see heat input computed live in kJ — multi-arc aware for tandem and twin setups, and it loads per-region ranges straight from a parsed WPS."{% else %}{{ sx_desc | jsonify }}{% endif %},
{% if sx_L == 'en' %}      "keywords": "welding heat input calculator, heat input formula, kJ/mm heat input, PQR range calculator, tandem arc heat input, EN 1011-1 heat input, welding qualification calculator",{% endif %}
{% if sx_L == 'en' %}      "featureList": [
        "Live heat input computed from current, voltage and travel speed",
        "Per-region qualified windows for root, fill and cap",
        "Sliders clamped to the WPQR-qualified range — out-of-range values not dialable",
        "Multi-arc aware: lead and trail heads summed for tandem and twin-arc",
        "Loads per-region ranges and processes from a parsed WPS in the library",
        "Scratch-pad only — nothing saved or written to any register"
      ],{% endif %}
      "offers": {
        "@type": "Offer",
        "price": "80",
        "priceCurrency": "EUR",
        "url": "https://delteris.com{{ sx_px }}/wps-management-software.html#pricing",
        "availability": "https://schema.org/InStock"
      },
      "provider": {
        "@id": "https://delteris.com/#organization"
      },
      "inLanguage": "{{ sx_lang }}"
    }
  ]
}

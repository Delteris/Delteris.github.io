{%- comment %} Localised by the sx_* variables set in _layouts/default.html; the FAQPage is
     generated there from the page's own visible FAQ. {%- endcomment %}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": "{{ sx_url }}#article",
      "headline": {% if sx_L == 'en' %}"How to Choose Welding Management Software"{% else %}{{ sx_name | jsonify }}{% endif %},
      "description": {% if sx_L == 'en' %}"How to choose welding management software: the questions that decide it long-term — WPS/WPQR handling, ISO 9606 and ASME IX qualification, NDT and PWHT tracking, data ownership, pricing and lock-in — with a neutral cloud-vs-on-premise vendor matrix."{% else %}{{ sx_desc | jsonify }}{% endif %},
      "inLanguage": "{{ sx_lang }}",
      "mainEntityOfPage": "{{ sx_url }}",
      "datePublished": "2026-08-01",
      "dateModified": "2026-09-23",
      "author": {
        "@type": "Organization",
        "name": "Delteris",
        "url": "https://delteris.com/"
      },
      "publisher": {
        "@id": "https://delteris.com/#organization"
      },
      "image": "https://delteris.com/static/DelterisCrest.webp"
    }
  ]
}

{%- comment %} Localised by the sx_* variables set in _layouts/default.html; the FAQPage is
     generated there from the page's own visible FAQ. {%- endcomment %}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": {% if sx_L == 'en' %}"Elenchon — Welding QMS & Access-Control Software"{% else %}{{ sx_name | jsonify }}{% endif %},
      "applicationCategory": "BusinessApplication",
      "applicationSubCategory": "Welding QMS Software",
      "operatingSystem": "Linux/Appliance",
      "description": {% if sx_L == 'en' %}"On-premise welding QMS and document-control software: global custom roles, a permission-filtered interface that hides what a user cannot see, one-click document generation into your own templates, and role-filtered notifications, all on hardware you own."{% else %}{{ sx_desc | jsonify }}{% endif %},
{% if sx_L == 'en' %}      "keywords": "welding QMS software, welding document control software, welding access control software, welding quality management software, role based welding software",{% endif %}
{% if sx_L == 'en' %}      "featureList": [
        "Global custom roles with top-down permission management",
        "Permission-filtered interface that hides unauthorised features and data",
        "One-click document generation into your own templates",
        "Role-filtered notifications for expirations and maintenance",
        "Version-pinned, locked records for ISO 3834, EN 1090 and ASME IX",
        "On-premise appliance with full data sovereignty"
      ],{% endif %}
      "offers": {
        "@type": "Offer",
        "url": "https://delteris.com{{ sx_px }}/pricing.html",
        "availability": "https://schema.org/PreOrder",
        "availabilityStarts": "2027-01-01"
      },
      "provider": {
        "@id": "https://delteris.com/#organization"
      },
      "inLanguage": "{{ sx_lang }}"
    }
  ]
}

{%- assign L = page.lang | default: 'en' -%}
{%- if L == 'en' %}{% assign px = '' %}{% else %}{% assign px = '/' | append: L %}{% endif -%}
{%- if page.update_product == 'atlas' %}{% assign pname = 'Elenchon Atlas' %}{% else %}{% assign pname = 'Elenchon' %}{% endif -%}
{%- if L == 'pt' %}{% assign t_upd = 'Atualizações' %}{% elsif L == 'es' %}{% assign t_upd = 'Novedades' %}{% else %}{% assign t_upd = 'Updates' %}{% endif -%}
{%- assign home = px | append: '/' | append: page.update_product | append: '/updates/' -%}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Delteris", "item": "{{ px | append: '/' | absolute_url }}" },
        { "@type": "ListItem", "position": 2, "name": {{ pname | append: ' · ' | append: t_upd | jsonify }}, "item": "{{ home | absolute_url }}" },
        { "@type": "ListItem", "position": 3, "name": {{ page.heading | default: page.title | jsonify }}, "item": "{{ page.url | absolute_url }}" }
      ]
    },
    {
      "@type": "BlogPosting",
      "@id": "{{ page.url | absolute_url }}#post",
      "headline": {{ page.heading | default: page.title | jsonify }},
      "description": {{ page.summary | jsonify }},
      "inLanguage": "{% if L == 'pt' %}pt-PT{% elsif L == 'es' %}es-ES{% else %}en{% endif %}",
      "datePublished": "{{ page.date | date: '%Y-%m-%d' }}",
      "dateModified": "{{ page.last_modified_at | default: page.date | date: '%Y-%m-%d' }}",
      "url": "{{ page.url | absolute_url }}",
      {%- if page.image %}
      "image": "{{ page.image | absolute_url }}",
      {%- endif %}
      "author": { "@type": "Organization", "name": "Delteris", "url": "https://delteris.com/" },
      "publisher": { "@type": "Organization", "name": "Delteris", "url": "https://delteris.com/", "logo": { "@type": "ImageObject", "url": "https://delteris.com/static/favicon-512.png" } },
      "isPartOf": { "@type": "Blog", "@id": "{{ home | absolute_url }}#blog", "name": {{ pname | append: ' · ' | append: t_upd | jsonify }} },
      "about": { "@type": "SoftwareApplication", "name": {{ pname | jsonify }} }
    }
  ]
}

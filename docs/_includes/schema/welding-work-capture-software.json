{%- comment %} Localised by the sx_* variables set in _layouts/default.html; the FAQPage is
     generated there from the page's own visible FAQ. {%- endcomment %}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": {% if sx_L == 'en' %}"Elenchon — Shop-Floor Weld Data Capture Software"{% else %}{{ sx_name | jsonify }}{% endif %},
      "applicationCategory": "BusinessApplication",
      "applicationSubCategory": "Welding Traceability App",
      "operatingSystem": "Linux/Appliance",
      "description": {% if sx_L == 'en' %}"On-premise shop-floor weld data capture software: a mobile-first floor app that logs welding, fit-up, cutting and any custom work type in ten seconds, captures work offline with automatic sync, and keeps every record on hardware you own."{% else %}{{ sx_desc | jsonify }}{% endif %},
{% if sx_L == 'en' %}      "keywords": "shop floor weld data capture, welding traceability app, weld data capture software, offline welding capture, mobile welding app, welding work capture software",{% endif %}
{% if sx_L == 'en' %}      "featureList": [
        "10-second mobile-first work capture with touch-and-PIN sign-in",
        "Universal custom work types (welding, fit-up, cutting, assembly)",
        "Offline work capture with durable on-device queue and automatic sync",
        "Attributed, timestamped, version-pinned entries",
        "Audit-ready ISO 3834, EN 1090 and ASME IX evidence",
        "On-premise appliance with full data sovereignty"
      ],{% endif %}
      "offers": {
        "@type": "Offer",
        "url": "https://delteris.com{{ sx_px }}/pricing.html",
        "availability": "https://schema.org/PreOrder",
        "availabilityStarts": "2027-01-01"
      },
      "provider": {
        "@id": "https://delteris.com/#organization"
      },
      "inLanguage": "{{ sx_lang }}"
    }
  ]
}

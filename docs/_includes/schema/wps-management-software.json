{%- comment %} Localised by the sx_* variables set in _layouts/default.html; the FAQPage is
     generated there from the page's own visible FAQ. {%- endcomment %}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": {% if sx_L == 'en' %}"Elenchon Atlas — WPS Management Software"{% else %}{{ sx_name | jsonify }}{% endif %},
      "applicationCategory": "BusinessApplication",
      "applicationSubCategory": "WPS Management Software",
      "operatingSystem": "Cloud / Web",
      "description": {% if sx_L == 'en' %}"Cloud WPS management software that keeps a shop's master WPS register current. It imports existing Welding Procedure Specification documents in Excel or PDF, extracts every field, and proposes human-reviewed edits that are patched — only once approved — into the shop's own workbook. Each register is versioned and exportable, with the linked WPQR and preliminary WPS (pWPS) chain kept alongside. Includes a library with structured detail and faceted search, a preview mode that compares the parse against the source document, and a heat-input helper. From Delteris — the standalone cloud WPS engine from the Elenchon platform."{% else %}{{ sx_desc | jsonify }}{% endif %},
{% if sx_L == 'en' %}      "keywords": "WPS management software, WPS software, WPS library, WPS register, WPS document management, welding procedure specification management, WPS import, WPS parser, WPS PDF import, WPS Excel import, organize WPS, find WPS by process",{% endif %}
{% if sx_L == 'en' %}      "featureList": [
        "Import existing WPS documents from Excel and PDF with automatic field extraction",
        "Batch import of a whole WPS library at once",
        "Human-reviewed change-sets — nothing is written to the register without approval",
        "Only approved cells are patched into the shop's own workbook; the file is never rebuilt",
        "Versioned register (v1, v2, v3...) with rollback and on-demand Excel export plus linked files",
        "WPS library with structured detail (header fields, pass table with side and role, parts, fillers, shielding)",
        "Automatic revision grouping and import classification (new WPS, new revision, correction)",
        "Preview mode — parsed fields shown beside the original PDF or Excel source, with in-place edit and verify",
        "Faceted search and filtering by process, material, position, range, side, role, link status and file type",
        "Linked document chain per WPS — attached WPQR and pWPS, visible and printable",
        "Heat-input helper that keeps parameters inside the WPQR-qualified window",
        "Automatic heat-input calculation on import (EN 1011-1) flagged for review",
        "Single-tenant deployment, a full history of changes, and configurable data retention",
        "Light WPS authoring and clean Excel export (authoring on roadmap)"
      ],{% endif %}
      "offers": {
        "@type": "Offer",
        "url": "{{ sx_url }}#pricing",
        "price": "80.00",
        "priceCurrency": "EUR",
        "availability": "https://schema.org/InStock",
        "description": {% if sx_L == 'pt' %}"80 € por mês, ou 720 € por ano (60 €/mês efetivos) com faturação anual. Preço fixo e totalmente publicado. Inclui 50 GB de armazenamento; blocos adicionais de 50 GB a 10 €/mês. Uma instância dedicada por sistema."{% elsif sx_L == 'es' %}"80 € al mes, o 720 € al año (60 €/mes efectivos) con facturación anual. Precio fijo y totalmente publicado. Incluye 50 GB de almacenamiento; bloques adicionales de 50 GB a 10 €/mes. Una instancia dedicada por sistema."{% else %}"€80 per month, or €720 per year (effective €60/month) billed annually. Flat, fully published price. Includes 50 GB storage; additional 50 GB blocks €10/month. One tenancy per system."{% endif %},
        "priceValidUntil": "2028-12-31"
      },
      "provider": {
        "@id": "https://delteris.com/#organization"
      },
      "inLanguage": "{{ sx_lang }}"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ sx_home_name | jsonify }}, "item": "{{ sx_home }}" },
        { "@type": "ListItem", "position": 2, "name": "Atlas", "item": "{{ sx_url }}" }
      ]
    }
  ]
}

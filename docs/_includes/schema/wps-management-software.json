{%- comment %} Localised by the sx_* variables set in _layouts/default.html; the FAQPage is
     generated there from the page's own visible FAQ. {%- endcomment %}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": {% if sx_L == 'en' %}"Elenchon Atlas — Welder Qualification & WPS Management Software"{% else %}{{ sx_name | jsonify }}{% endif %},
      "applicationCategory": "BusinessApplication",
      "applicationSubCategory": "Welder Qualification & WPS Management Software",
      "operatingSystem": "Cloud / Web",
      "description": {% if sx_L == 'en' %}"Cloud welder qualification and WPS management software for fabrication shops. It tracks every welder's qualifications (WPQ) by expiry and continuity — two clocks per certificate — with a colour-coded roster, signed requalification and email reminders before anything lapses, and shows which welders' current certificates cover each WPS. It imports the shop's existing WPS and pWPS from Excel or PDF into structured, searchable records through human-reviewed edits, keeps the WPQR behind each WPS, and checks every WPS against its WPQR's range of qualification. Versioned, exportable register and a monthly report. From Delteris."{% else %}{{ sx_desc | jsonify }}{% endif %},
{% if sx_L == 'en' %}      "keywords": "welder qualification software, welder qualification tracking, WPQ tracking, welder certificate expiry, welder continuity, WPS management software, WPS software, WPS library, WPS register, WPS document management, welding procedure specification management, WPS import, WPS parser, WPS PDF import, WPS Excel import, organize WPS, find WPS by process",{% endif %}
{% if sx_L == 'en' %}      "featureList": [
        "Welder qualification (WPQ) tracking by expiry and continuity — two clocks per certificate",
        "Colour-coded welder roster, signed requalification and email reminders before a qualification lapses",
        "Welder coverage — which welders' current certificates cover each WPS, and which WPS each welder can weld",
        "WPQR range check — every linked WPS checked field by field against its WPQR's range of qualification",
        "Monthly report of range check results and welder qualification status",
        "Import existing WPS documents from Excel and PDF with automatic field extraction",
        "Batch import of a whole WPS library at once",
        "Human-reviewed change-sets — nothing is written to the register without approval",
        "Only approved cells are patched into the shop's own workbook; the file is never rebuilt",
        "Versioned register (v1, v2, v3...) with rollback and on-demand Excel export plus linked files",
        "WPS library with structured detail (header fields, pass table with side and role, parts, fillers, shielding)",
        "Automatic revision grouping and import classification (new WPS, new revision, correction)",
        "Preview mode — parsed fields shown beside the original PDF or Excel source, with in-place edit and verify",
        "Faceted search and filtering by process, material, position, range, side, role, link status and file type",
        "Linked document chain per WPS — attached WPQR and pWPS, visible and printable",
        "Heat-input helper that keeps parameters inside the WPQR-qualified window",
        "Automatic heat-input calculation on import (EN 1011-1) flagged for review",
        "Single-tenant deployment, a full history of changes, and configurable data retention",
        "Light WPS authoring and clean Excel export (authoring on roadmap)"
      ],{% endif %}
      "offers": {
        "@type": "Offer",
        "url": "{{ sx_url }}#pricing",
        "price": "60.00",
        "priceCurrency": "EUR",
        "availability": "https://schema.org/InStock",
        "description": {% if sx_L == 'pt' %}"60 € por mês com faturação anual (720 € por ano), ou 80 € mês a mês. Preço fixo e totalmente publicado. Inclui 50 GB de armazenamento; blocos adicionais de 50 GB a 10 €/mês. Uma instância dedicada por sistema."{% elsif sx_L == 'es' %}"60 € al mes con facturación anual (720 € al año), u 80 € mes a mes. Precio fijo y totalmente publicado. Incluye 50 GB de almacenamiento; bloques adicionales de 50 GB a 10 €/mes. Una instancia dedicada por sistema."{% else %}"€60 per month billed annually (€720 per year), or €80 month to month. Flat, fully published price. Includes 50 GB storage; additional 50 GB blocks €10/month. One tenancy per system."{% endif %},
        "priceValidUntil": "2028-12-31"
      },
      "provider": {
        "@id": "https://delteris.com/#organization"
      },
      "inLanguage": "{{ sx_lang }}"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ sx_home_name | jsonify }}, "item": "{{ sx_home }}" },
        { "@type": "ListItem", "position": 2, "name": "Atlas", "item": "{{ sx_url }}" }
      ]
    }
  ]
}

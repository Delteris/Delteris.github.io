{%- assign L = page.lang | default: 'en' -%}
{%- if L == 'en' %}{% assign px = '' %}{% else %}{% assign px = '/' | append: L %}{% endif -%}
{%- if page.update_product == 'atlas' %}{% assign pname = 'Elenchon Atlas' %}{% else %}{% assign pname = 'Elenchon' %}{% endif -%}
{%- if L == 'pt' %}{% assign t_upd = 'Atualizações' %}{% elsif L == 'es' %}{% assign t_upd = 'Novedades' %}{% else %}{% assign t_upd = 'Updates' %}{% endif -%}
{%- assign posts = site.updates | where: 'update_product', page.update_product | where: 'lang', L | sort: 'date' | reverse -%}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Delteris", "item": "{{ px | append: '/' | absolute_url }}" },
        { "@type": "ListItem", "position": 2, "name": {{ pname | append: ' · ' | append: t_upd | jsonify }}, "item": "{{ page.url | absolute_url }}" }
      ]
    },
    {
      "@type": "Blog",
      "@id": "{{ page.url | absolute_url }}#blog",
      "name": {{ pname | append: ' · ' | append: t_upd | jsonify }},
      "description": {{ page.description | jsonify }},
      "url": "{{ page.url | absolute_url }}",
      "inLanguage": "{% if L == 'pt' %}pt-PT{% elsif L == 'es' %}es-ES{% else %}en{% endif %}",
      "publisher": { "@type": "Organization", "name": "Delteris", "url": "https://delteris.com/" },
      "blogPost": [
{%- for p in posts %}
        { "@type": "BlogPosting", "headline": {{ p.heading | default: p.title | jsonify }}, "url": "{{ p.url | absolute_url }}", "datePublished": "{{ p.date | date: '%Y-%m-%d' }}" }{% unless forloop.last %},{% endunless %}
{%- endfor %}
      ]
    }
  ]
}

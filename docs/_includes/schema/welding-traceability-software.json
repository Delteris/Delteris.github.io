{%- comment %} Localised by the sx_* variables set in _layouts/default.html; the FAQPage is
     generated there from the page's own visible FAQ. {%- endcomment %}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": {% if sx_L == 'en' %}"Elenchon — Welding Traceability Software"{% else %}{{ sx_name | jsonify }}{% endif %},
      "applicationCategory": "BusinessApplication",
      "applicationSubCategory": "Welding Traceability Software",
      "operatingSystem": "Linux/Appliance",
      "description": {% if sx_L == 'en' %}"On-premise welding traceability software that records the full chain of custody behind every weld — base-material heat numbers, attributed shop-floor capture, the qualified procedure and welder, and version-locked records — producing audit-ready ISO 3834, EN 1090 and ASME IX evidence, all on hardware you own."{% else %}{{ sx_desc | jsonify }}{% endif %},
{% if sx_L == 'en' %}      "keywords": "welding traceability software, weld tracking software, weld traceability, heat number traceability, material traceability welding, weld chain of custody software",{% endif %}
{% if sx_L == 'en' %}      "featureList": [
        "Heat-number capture linked to MTRs and propagated down the project tree",
        "Attributed, timestamped shop-floor capture",
        "Welds linked to their WPS and the welder's WPQ",
        "Bidirectional trace from finished piece to base material",
        "Version-pinned, locked records for audit-grade integrity",
        "Audit-ready ISO 3834, EN 1090 and ASME IX evidence",
        "On-premise appliance with full data sovereignty"
      ],{% endif %}
      "offers": {
        "@type": "Offer",
        "url": "https://delteris.com{{ sx_px }}/pricing.html",
        "availability": "https://schema.org/PreOrder",
        "availabilityStarts": "2027-01-01"
      },
      "provider": {
        "@id": "https://delteris.com/#organization"
      },
      "inLanguage": "{{ sx_lang }}"
    }
  ]
}

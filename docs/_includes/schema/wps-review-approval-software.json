{%- comment %} Localised by the sx_* variables set in _layouts/default.html; the FAQPage is
     generated there from the page's own visible FAQ. {%- endcomment %}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": {% if sx_L == 'en' %}"Elenchon Atlas — WPS Review & Approval Software"{% else %}{{ sx_name | jsonify }}{% endif %},
      "applicationCategory": "BusinessApplication",
      "applicationSubCategory": "WPS Management Software",
      "operatingSystem": "Cloud",
      "description": {% if sx_L == 'en' %}"Cloud WPS review-and-approval software: every import queues as a change-set showing current value beside new value, cell by cell, with low-confidence reads flagged, drift detection between library and register, a configurable approval bar, and only approved cells patched into your own workbook."{% else %}{{ sx_desc | jsonify }}{% endif %},
{% if sx_L == 'en' %}      "keywords": "WPS review software, WPS approval workflow, WPS change management, human-reviewed register edits, WPS register control, WPS drift detection",{% endif %}
{% if sx_L == 'en' %}      "featureList": [
        "Cell-by-cell change-set showing current value versus new value",
        "Inline correction and add-a-row before approval",
        "Low-confidence and computed reads flagged in amber",
        "Configurable approval bar: review all, review uncertain only, or auto-apply",
        "Drift detection between library documents and the register with reviewed re-sync",
        "Only approved cells patched into your own workbook; every change-set versioned"
      ],{% endif %}
      "offers": {
        "@type": "Offer",
        "price": "80",
        "priceCurrency": "EUR",
        "url": "https://delteris.com{{ sx_px }}/wps-management-software.html#pricing",
        "availability": "https://schema.org/InStock"
      },
      "provider": {
        "@id": "https://delteris.com/#organization"
      },
      "inLanguage": "{{ sx_lang }}"
    }
  ]
}

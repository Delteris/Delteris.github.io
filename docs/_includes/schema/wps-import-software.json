{%- comment %} Localised by the sx_* variables set in _layouts/default.html; the FAQPage is
     generated there from the page's own visible FAQ. {%- endcomment %}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": {% if sx_L == 'en' %}"Elenchon Atlas — WPS Import Software"{% else %}{{ sx_name | jsonify }}{% endif %},
      "applicationCategory": "BusinessApplication",
      "applicationSubCategory": "WPS Management Software",
      "operatingSystem": "Cloud",
      "description": {% if sx_L == 'en' %}"Cloud WPS import software with native Excel and PDF parsers: reads process, materials, positions, ranges and pass-by-pass parameters into structured fields. The parser reads a form's structure rather than a fixed vocabulary, so it is language-agnostic — it matches labels from a per-customer language pack, imports in batch, computes heat input where a form omits it, and is tuned to your company's exact template."{% else %}{{ sx_desc | jsonify }}{% endif %},
{% if sx_L == 'en' %}      "keywords": "WPS import software, WPS parser, Excel WPS import, PDF WPS import, welding procedure import, WPS data extraction, ISO 15609 WPS",{% endif %}
{% if sx_L == 'en' %}      "featureList": [
        "Native Excel WPS workbook parser",
        "PDF WPS form grid reconstruction and cell reading",
        "Structured extraction of process, materials, ranges and pass-by-pass parameters",
        "Language-agnostic label matching from a per-customer language pack (English and Portuguese shipped)",
        "Batch import with automatic new/revision/correction classification",
        "Heat input computed from arc parameters (EN 1011-1) where a form leaves it blank",
        "Parser tuned to your company's exact WPS template during onboarding"
      ],{% endif %}
      "offers": {
        "@type": "Offer",
        "price": "80",
        "priceCurrency": "EUR",
        "priceValidUntil": "2028-12-31",
        "url": "https://delteris.com{{ sx_px }}/wps-management-software.html#pricing",
        "availability": "https://schema.org/InStock"
      },
      "provider": {
        "@id": "https://delteris.com/#organization"
      },
      "inLanguage": "{{ sx_lang }}"
    }
  ]
}

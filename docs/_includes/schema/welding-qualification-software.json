{%- comment %} Localised by the sx_* variables set in _layouts/default.html; the FAQPage is
     generated there from the page's own visible FAQ. {%- endcomment %}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": {% if sx_L == 'en' %}"Elenchon — Welding Qualification Workflow Software"{% else %}{{ sx_name | jsonify }}{% endif %},
      "applicationCategory": "BusinessApplication",
      "applicationSubCategory": "Welding Qualification Software",
      "operatingSystem": "Linux/Appliance",
      "description": {% if sx_L == 'en' %}"On-premise welding qualification software that runs the full WPS, WPQR and WPQ workflow — define and qualify welding procedures, capture WPQR procedure data on the shop floor, track welder continuity (WPQ), and produce audit-ready ISO and ASME IX evidence."{% else %}{{ sx_desc | jsonify }}{% endif %},
{% if sx_L == 'en' %}      "keywords": "welding qualification software, WPS software, PQR software, WPQ software, welder qualification software, welding procedure specification software, procedure qualification record software",{% endif %}
{% if sx_L == 'en' %}      "featureList": [
        "WPS (Welding Procedure Specification) authoring and range management",
        "WPQR (Welding Procedure Qualification Record, equivalent to ASME PQR) capture on the shop floor",
        "WPQ (Welder Performance Qualification) continuity tracking",
        "Automatic 6-month welder continuity tracking with expiry alerts",
        "Version-pinned, locked qualification records",
        "Audit-ready ISO and ASME IX evidence",
        "On-premise appliance with full data sovereignty"
      ],{% endif %}
      "offers": {
        "@type": "Offer",
        "url": "https://delteris.com{{ sx_px }}/pricing.html",
        "availability": "https://schema.org/PreOrder",
        "availabilityStarts": "2027-01-01"
      },
      "provider": {
        "@id": "https://delteris.com/#organization"
      },
      "inLanguage": "{{ sx_lang }}"
    }
  ]
}

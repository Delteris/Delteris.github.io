{%- comment %} Localised by the sx_* variables set in _layouts/default.html; the FAQPage is
     generated there from the page's own visible FAQ. {%- endcomment %}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "url": "{{ sx_url }}",
      "name": {% if sx_L == 'en' %}"Elenchon Atlas — Security"{% else %}{{ sx_name | jsonify }}{% endif %},
      "description": {% if sx_L == 'en' %}"How Elenchon Atlas secures a cloud WPS register: a searchable history of every change, role-based access with a read-only inspector seat, single-tenant isolation, EU hosting, and encryption in transit."{% else %}{{ sx_desc | jsonify }}{% endif %},
      "isPartOf": {
        "@id": "https://delteris.com{{ sx_px }}/wps-management-software.html"
      },
      "about": {
        "@id": "https://delteris.com/#organization"
      },
      "inLanguage": "{{ sx_lang }}"
    }
  ]
}
